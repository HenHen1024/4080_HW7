
// chunk.h — add before the Chunk struct
typedef struct {
  int offset;
  int line;
} LineStart;

// chunk.h — add these fields to the existing Chunk struct
int lineCount;
int lineCapacity;
LineStart* lines;

// chunk.h — add declaration
int getLine(Chunk* chunk, int instruction);


// chunk.c — initialize the new fields in initChunk()
chunk->lineCount = 0;
chunk->lineCapacity = 0;
chunk->lines = NULL;

// chunk.c — add this cleanup to freeChunk(), preserving existing cleanup
FREE_ARRAY(LineStart, chunk->lines, chunk->lineCapacity);

// chunk.c — replace writeChunk()
void writeChunk(Chunk* chunk, uint8_t byte, int line) {
  if (chunk->capacity < chunk->count + 1) {
    int oldCapacity = chunk->capacity;
    chunk->capacity = GROW_CAPACITY(oldCapacity);
    chunk->code = GROW_ARRAY(uint8_t, chunk->code,
                             oldCapacity, chunk->capacity);
  }

  chunk->code[chunk->count] = byte;
  chunk->count++;

  // Consecutive bytes from the same source line share one entry.
  if (chunk->lineCount > 0 &&
      chunk->lines[chunk->lineCount - 1].line == line) {
    return;
  }

  if (chunk->lineCapacity < chunk->lineCount + 1) {
    int oldCapacity = chunk->lineCapacity;
    chunk->lineCapacity = GROW_CAPACITY(oldCapacity);
    chunk->lines = GROW_ARRAY(LineStart, chunk->lines,
                              oldCapacity, chunk->lineCapacity);
  }

  LineStart* lineStart = &chunk->lines[chunk->lineCount++];
  lineStart->offset = chunk->count - 1;
  lineStart->line = line;
}

// chunk.c — add getLine()
int getLine(Chunk* chunk, int instruction) {
  int start = 0;
  int end = chunk->lineCount - 1;

  while (start <= end) {
    int mid = (start + end) / 2;

    if (chunk->lines[mid].offset <= instruction) {
      if (mid == chunk->lineCount - 1 ||
          chunk->lines[mid + 1].offset > instruction) {
        return chunk->lines[mid].line;
      }
      start = mid + 1;
    } else {
      end = mid - 1;
    }
  }

  return -1; // Invalid instruction offset.
}

// object.c — replace the OBJ_STRING case in freeObject().
case OBJ_STRING: {
  ObjString* string = (ObjString*)object;
  if (string->ownsChars) {
    FREE_ARRAY(char, string->chars, string->length + 1);
  }
  FREE(ObjString, object);
  break;
}

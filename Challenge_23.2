/*
 * Crafting Interpreters — Chapter 23, Challenge 2
 *
 * Add continue statements to clox.
 *
 * Files that need changes:
 *   scanner.h
 *   scanner.c
 *   compiler.c
 *
 * continue:
 *
 *   continue;
 *
 * It jumps to the beginning of the nearest enclosing loop.
 *
 * In a for loop with an increment expression, it jumps to
 * the increment expression first.
 */


/* ============================================================
 * scanner.h
 * ============================================================ */

/*
 * Add:
 *
 * TOKEN_CONTINUE
 */


/* ============================================================
 * scanner.c
 * ============================================================ */

/*
 * Add "continue" to identifierType().
 */

case 'c':
  if (checkKeyword(1, 7, "ontinue", TOKEN_CONTINUE)) {
    return TOKEN_CONTINUE;
  }

  if (checkKeyword(1, 3, "ase", TOKEN_CASE)) {
    return TOKEN_CASE;
  }

  break;


/* ============================================================
 * compiler.c
 * ============================================================ */

/*
 * Track the beginning of the current loop.
 */

static int loopStart = -1;


/*
 * Track whether we are currently inside a loop.
 */

static int loopDepth = 0;


/*
 * Add continueStatement().
 */

static void continueStatement() {
  consume(TOKEN_SEMICOLON,
          "Expect ';' after 'continue'.");

  if (loopDepth == 0) {
    error("Can't use 'continue' outside of a loop.");
    return;
  }

  emitLoop(loopStart);
}


/*
 * Add continue to statement().
 */

static void statement() {

  if (match(TOKEN_PRINT)) {
    printStatement();

  } else if (match(TOKEN_FOR)) {
    forStatement();

  } else if (match(TOKEN_IF)) {
    ifStatement();

  } else if (match(TOKEN_WHILE)) {
    whileStatement();

  } else if (match(TOKEN_CONTINUE)) {
    continueStatement();

  } else if (match(TOKEN_LEFT_BRACE)) {
    beginScope();
    block();
    endScope();

  } else {
    expressionStatement();
  }
}


/* ============================================================
 * whileStatement()
 * ============================================================ */

static void whileStatement() {
  int enclosingLoopStart = loopStart;
  int enclosingLoopDepth = loopDepth;

  loopStart = currentChunk()->count;
  loopDepth++;

  consume(TOKEN_LEFT_PAREN, "Expect '(' after 'while'.");
  expression();
  consume(TOKEN_RIGHT_PAREN, "Expect ')' after condition.");

  int exitJump = emitJump(OP_JUMP_IF_FALSE);
  emitByte(OP_POP);

  statement();

  emitLoop(loopStart);

  patchJump(exitJump);
  emitByte(OP_POP);

  /*
   * Restore the outer loop information.
   */

  loopStart = enclosingLoopStart;
  loopDepth = enclosingLoopDepth;
}


/* ============================================================
 * forStatement()
 * ============================================================ */

static void forStatement() {
  beginScope();

  consume(TOKEN_LEFT_PAREN, "Expect '(' after 'for'.");

  /*
   * Initializer.
   */

  if (match(TOKEN_SEMICOLON)) {
    // No initializer.

  } else if (match(TOKEN_VAR)) {
    varDeclaration();

  } else {
    expressionStatement();
  }

  /*
   * Condition.
   */

  int exitJump = -1;

  if (!match(TOKEN_SEMICOLON)) {
    expression();

    consume(TOKEN_SEMICOLON,
            "Expect ';' after loop condition.");

    exitJump = emitJump(OP_JUMP_IF_FALSE);
    emitByte(OP_POP);
  }

  /*
   * Save the enclosing loop information.
   */

  int enclosingLoopStart = loopStart;
  int enclosingLoopDepth = loopDepth;

  /*
   * The increment expression is the correct target for
   * continue when the for loop has an increment clause.
   */

  int incrementStart = currentChunk()->count;

  if (!match(TOKEN_RIGHT_PAREN)) {
    int bodyJump = emitJump(OP_JUMP);

    int incrementStart = currentChunk()->count;

    expression();
    emitByte(OP_POP);

    consume(TOKEN_RIGHT_PAREN,
            "Expect ')' after for clauses.");

    emitLoop(incrementStart);

    patchJump(bodyJump);
  }

  /*
   * A continue inside the body should jump to the increment
   * expression when one exists. Otherwise it jumps to the
   * normal loop start.
   */

  loopStart = incrementStart;
  loopDepth++;

  statement();

  emitLoop(loopStart);

  if (exitJump != -1) {
    patchJump(exitJump);
    emitByte(OP_POP);
  }

  endScope();

  /*
   * Restore the enclosing loop.
   */

  loopStart = enclosingLoopStart;
  loopDepth = enclosingLoopDepth;
}
